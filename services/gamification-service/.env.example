PORT=3003
NODE_ENV=development

# PostgreSQL (durable: points_ledger, badges_earned, user_stats)
DB_HOST=gamification-db
DB_PORT=5432
DB_NAME=gamification
DB_USER=gamification_user
DB_PASSWORD=changeme

# Redis (leaderboard sorted set + profile cache)
REDIS_HOST=gamification-cache
REDIS_PORT=6379

# JWT dogrulama (public key - Identity Service'in JWKS/public key'i, sadece dogrulama icin)
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# RabbitMQ (bu servis sadece dinleyicidir - incident.resolved, incident.resolution.rated, incident.sla.exceeded)
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=netopscell_app
RABBITMQ_PASSWORD=changeme

# Manuel test kancasi (/internal/simulate-event) icin
INTERNAL_API_KEY=netopscell-internal-dev-key

# CORS - izin verilen frontend origin'leri (virgulle ayrilir)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
