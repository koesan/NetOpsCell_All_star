PORT=8000
ENV=development

# PostgreSQL (predictions, misclassifications, team_cache, model_registry)
DB_HOST=ai-db
DB_PORT=5432
DB_NAME=ai
DB_USER=ai_user
DB_PASSWORD=changeme

# Model — ariza turu siniflandirma (birinci model)
MODEL_PATH=./models/model_v1.joblib
MODEL_VERSION=v1
MIN_ACCEPTABLE_MACRO_F1=0.85

# Model — cozum suresi tahmini / ETA regresyonu (ikinci model, bkz. ML_APPROACH.md Bolum 10)
ETA_MODEL_PATH=./models/eta_model_v1.joblib
ETA_MODEL_VERSION=v1
MAX_ACCEPTABLE_ETA_MAE=40

# Model — eskalasyon riski (ucuncu model, GERCEK Telstra/Kaggle verisi, bkz. ML_APPROACH.md Bolum 11)
SEVERITY_MODEL_PATH=./models/severity_model_v1.joblib
SEVERITY_MODEL_VERSION=v1

# Gemini LLM — musteri sikayet on analizi (opsiyonel; bkz. kok README "Gemini API Anahtari Kurulumu")
# Anahtar KODA/REPOYA yazilmaz: Docker secret olarak secrets/gemini_api_key.txt'den mount edilir.
# Yerel gelistirmede: GEMINI_API_KEY=<anahtariniz> ortam degiskeni de kullanilabilir.
GEMINI_MODEL=gemini-2.5-flash-lite

# Esik degerleri (Bolum 9.2)
THRESHOLD_IZLE=0.40
THRESHOLD_ACIL=0.85

# Akilli atama skor agirliklari (Bolum 9.2)
SCORE_WEIGHT_UZMANLIK=0.4
SCORE_WEIGHT_MESAFE=0.3
SCORE_WEIGHT_BOSLUK=0.3
TEAM_MAX_CAPACITY=5

# RabbitMQ (team.profile.updated, incident.type.changed dinlenir)
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=netopscell_app
RABBITMQ_PASSWORD=changeme

# Internal REST (Identity/Incident Service - dahili ag uzerinden, retry+backoff'lu)
IDENTITY_SERVICE_INTERNAL_URL=http://identity-service:3001
INCIDENT_SERVICE_INTERNAL_URL=http://incident-service:3002
INTERNAL_API_KEY=netopscell-internal-dev-key

# CORS - izin verilen frontend origin'leri (virgulle ayrilir)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
