PORT=3001
NODE_ENV=development

# PostgreSQL
DB_HOST=identity-db
DB_PORT=5432
DB_NAME=identity
DB_USER=identity_user
DB_PASSWORD=changeme

# JWT (RS256 - private key sadece bu serviste tutulur)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# OTP teslimati — gercek kanal: Telegram Bot API (bkz. kok README "Telegram OTP Kurulumu").
# Bot token bos/tanimsizsa asagidaki sabit kodlu SIMULASYON fallback'i devreye girer
# (yalnizca yerel gelistirme icin; kod hicbir zaman API yanitinda veya UI'da donmez,
# sadece sunucu logunda goruntulenir).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
OTP_FIXED_CODE=1234

# Hesap kilitleme
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=netopscell_app
RABBITMQ_PASSWORD=changeme

# Dahili servisler arasi endpoint korumasi (orn. /internal/teams)
INTERNAL_API_KEY=netopscell-internal-dev-key

# CORS - izin verilen frontend origin'leri (virgulle ayrilir)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Not: docker-compose.yml icinde bu degerlerin hepsi *_FILE varyanti ile Docker
# secret olarak saglanir (bkz. scripts/generate-secrets.sh, secrets/README.md).
# Bu dosya sadece Docker disinda yerel gelistirme icindir.
