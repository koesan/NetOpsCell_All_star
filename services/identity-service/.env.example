PORT=3001
NODE_ENV=development

# PostgreSQL
DB_HOST=identity-db
DB_PORT=5432
DB_NAME=identity
DB_USER=identity_user
DB_PASSWORD=changeme

# JWT (RS256 - private key sadece bu serviste tutulur)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# OTP teslimati — iki kademeli (bkz. kok README "Musteri OTP Dogrulamasi"):
# 1) Musteri e-posta girdiyse VE asagidaki SMTP_* tanimliysa: kod gercekten gonderilir.
# 2) Aksi halde: kod web'de gosterilir (varsayilan OTP_FIXED_CODE). Her iki durumda da
#    kod otp_codes tablosunda musteri kaydiyla (userId) iliskili saklanir.
OTP_FIXED_CODE=1234
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=

# Hesap kilitleme
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=netopscell_app
RABBITMQ_PASSWORD=changeme

# Dahili servisler arasi endpoint korumasi (orn. /internal/teams)
INTERNAL_API_KEY=netopscell-internal-dev-key

# CORS - izin verilen frontend origin'leri (virgulle ayrilir)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Not: docker-compose.yml icinde bu degerlerin hepsi *_FILE varyanti ile Docker
# secret olarak saglanir (bkz. scripts/generate-secrets.sh, secrets/README.md).
# Bu dosya sadece Docker disinda yerel gelistirme icindir.
