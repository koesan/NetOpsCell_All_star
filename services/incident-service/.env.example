PORT=3002
NODE_ENV=development

# PostgreSQL (iliskisel veri: vaka, SLA, durum gecmisi)
DB_HOST=incident-db
DB_PORT=5432
DB_NAME=incident
DB_USER=incident_user
DB_PASSWORD=changeme

# MongoDB (saha mesajlasma: mesaj icerigi, teslim/okunma durumu - bkz. Faz 3)
MONGO_HOST=incident-mongo
MONGO_PORT=27017
MONGO_USER=incident_service
MONGO_PASSWORD=changeme
MONGO_DB=incident_messages

# JWT dogrulama (public key - Identity Service'in JWKS/public key'i, sadece dogrulama icin)
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# AI Service entegrasyonu (senkron /predict cagrisi, circuit breaker ile korunur)
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT_MS=2000

# SLA sureleri (saat)
SLA_KRITIK_HOURS=1
SLA_YUKSEK_HOURS=4
SLA_ORTA_HOURS=12
SLA_DUSUK_HOURS=48

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=netopscell_app
RABBITMQ_PASSWORD=changeme

# Dahili servisler arasi endpoint korumasi (orn. /internal/teams/workload)
INTERNAL_API_KEY=netopscell-internal-dev-key
IDENTITY_SERVICE_URL=http://identity-service:3001

# CORS - izin verilen frontend origin'leri (virgulle ayrilir)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
